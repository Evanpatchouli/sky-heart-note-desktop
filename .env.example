# 根 Compose 在当前目录读取 .env。使用内置 MongoDB 时填写以下四个独立的随机值。
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COMPOSE_PROFILES=mongo
MONGO_ROOT_PASSWORD=
DB_MONGO_USERNAME=sky-club
DB_MONGO_PASSWORD=
SESSION_SECRET=
BOOTSTRAP_ADMIN_USERNAME=root
BOOTSTRAP_ADMIN_PASSWORD=
# 首次空库的俱乐部名称，之后由团长在团员端修改。
CLUB_NAME=Sky Club

# 可选三端设备提醒。只为 API 服务设置 VAPID 凭据。
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# WEB_PUSH_ALLOWED_ORIGINS=

# 生产部署时取消下列配置的注释并替换域名。四个前端共用同一个同站 HTTPS API。
# VITE_APP_API_BASE_URL=https://api.example.com/api
# ADMIN_ORIGIN=https://admin.example.com
# EMPLOYEE_ORIGIN=https://employee.example.com
# CLIENT_ORIGIN=https://client.example.com
# SITE_ORIGIN=https://www.example.com

# Eotion 已有 MongoDB 和边缘 Nginx 的 Linux 主机：
# 将上方 COMPOSE_PROFILES 设为空，设置已有数据库的连接和账号，再启用下列覆盖文件。
# COMPOSE_FILE=docker-compose.yml:docker-compose.eotion.yml
# DB_MONGO_CONNECTION=mongodb://mongodb:27017/sky-club
