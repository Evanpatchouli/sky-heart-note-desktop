{
  "name": "sky-heart-note",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:common": "pnpm --dir common build:watch",
    "dev:admin": "pnpm --dir admin dev",
    "dev:employee": "pnpm --dir employee dev",
    "dev:client": "pnpm --dir client dev",
    "dev:site": "pnpm --dir site dev",
    "dev:server": "pnpm --dir server start:dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm --dir server test --runInBand && node --test employee/test/pending-claims.test.mjs",
    "test:pwa": "node --test scripts/test-pwa.mjs"
  }
}
