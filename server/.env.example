APP_HOST=127.0.0.1
APP_PORT=8793
APP_ENV=development
DB_MONGO_CONNECTION=mongodb://127.0.0.1:27017/sky-club
# DB_MONGO_USERNAME=
# DB_MONGO_PASSWORD=
MIGRATE_ON_START=true
# 生成随机密钥，例如 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
BOOTSTRAP_ADMIN_USERNAME=root
# 首次迁移需要设置管理员密码，创建完成后可移除。
BOOTSTRAP_ADMIN_PASSWORD=
# 首次空库的俱乐部名称，之后由团长在团员端修改。
CLUB_NAME=Sky Club
ADMIN_ORIGIN=http://localhost:5173
EMPLOYEE_ORIGIN=http://localhost:5174
CLIENT_ORIGIN=http://localhost:5175
SITE_ORIGIN=http://localhost:5176
# 可选三端设备提醒。VAPID 联系地址使用 mailto: 或 HTTPS URL。
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# WEB_PUSH_ALLOWED_ORIGINS=
LOG_LEVEL=info
# 邮箱验证码登录使用的 SMTP 配置
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
