{
  "name": "@sky-club/server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "club:configure": "node dist/src/commands/club.js",
    "migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "migrate:force": "ts-node -r tsconfig-paths/register scripts/migrate.ts --force",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --test test/web-apps.e2e.mjs test/club-orders.e2e.mjs test/club-service-orders.e2e.mjs test/club-companionship.e2e.mjs test/club-single-operations.e2e.mjs test/club-gift-dispatch.e2e.mjs test/club-dispatch.e2e.mjs test/club-execution.e2e.mjs test/club-dispatch-notice.e2e.mjs test/club-dispatch-push.e2e.mjs test/club-delivery.e2e.mjs test/club-gift-supervision.e2e.mjs test/club-fulfillment.e2e.mjs test/club-settlement.e2e.mjs test/club-settlement-close.e2e.mjs test/club-withdrawals.e2e.mjs test/club-financial-adjustments.e2e.mjs test/club-dashboard.e2e.mjs test/club-delivery-review.e2e.mjs test/club-price-adjustment.e2e.mjs test/club-termination.e2e.mjs test/club-personal-schedule.e2e.mjs test/club-promotions.e2e.mjs"
  },
  "_moduleAliases": {
    "@": "dist/src",
    "@utils": "dist/src/utils",
    "@decorators": "dist/src/decorators",
    "@modules": "dist/src/modules"
  },
  "dependencies": {
    "@evanpatchouli/scheduler": "^1.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.5",
    "@sky-club/common": "workspace:*",
    "async_hooks": "^1.0.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "es-toolkit": "^1.44.0",
    "ipaddr.js": "^2.5.0",
    "log4js": "^6.9.1",
    "minimatch": "^10.1.1",
    "mitt": "^3.0.1",
    "module-alias": "^2.2.3",
    "mongoose": "^9.1.5",
    "nanoid": "^5.1.6",
    "nodemailer": "^8.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.9",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
